{
    "compilerOptions": {
      "target": "ES2020",
      "lib": ["ES2020", "DOM"],
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "jsx": "react-jsx",
      "baseUrl": ".",
      "paths": { "@infradeck/shared/*": ["../../packages/shared/src/*"] },
      "types": ["vite/client", "node"],
      "skipLibCheck": true,
      "strict": true
    },
    "include": ["src", "components", "hooks", "vite.config.ts"]
  }