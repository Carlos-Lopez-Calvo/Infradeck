{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@infradeck/shared": ["../packages/shared/src/index.ts"],
      "@infradeck/shared/*": ["../packages/shared/src/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}